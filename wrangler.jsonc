{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "solvathon",
	"compatibility_date": "2026-10-11",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"global_fetch_strictly_public"
	],
	"rules": [
		{
			"type": "CompiledWasm",
			"globs": ["**/*.wasm"],
			"fallthrough": true
		}
	],
	"vars": {
		"ADMIN_ACCESS_KEY": "warden_cyft_2025",
		"DATABASE_URL": "postgresql://postgres.ssfvzchtrsmmzpzoxakw:hessJhw-24%402...@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true",
		"DIRECT_URL": "postgresql://postgres.ssfvzchtrsmmzpzoxakw:hessJhw-24%402...@aws-0-ap-south-1.pooler.supabase.com:5432/postgres",
		"ADMIN_EMAILS": "atman.dash2025@vitstudent.ac.in,atmandash2007@gmail.com,suyash.srivastava2025@vitstudent.ac.in,triloknath.pandey@vit.ac.in,shashanka.shekhar2024@vitstudent.ac.in",
		"SUPER_ADMIN_EMAILS": "atman.dash2025@vitstudent.ac.in,atmandash2007@gmail.com",
		"NEXT_PUBLIC_ADMIN_EMAILS": "atman.dash2025@vitstudent.ac.in,atmandash2007@gmail.com,suyash.srivastava2025@vitstudent.ac.in,triloknath.pandey@vit.ac.in,shashanka.shekhar2024@vitstudent.ac.in",
		"NEXT_PUBLIC_SUPER_ADMIN_EMAILS": "atman.dash2025@vitstudent.ac.in,atmandash2007@gmail.com",
		"NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyBQZ0xOLGXQ9MDc9BfAgI_MrZxnO7SOyxY",
		"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "solvathon-8d5e3.firebaseapp.com",
		"NEXT_PUBLIC_FIREBASE_PROJECT_ID": "solvathon-8d5e3"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "solvathon"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	}
}