generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Team {
  id           String        @id @default(uuid())
  name         String        @unique
  teamCode     String        @unique @default(cuid())
  leaderId     String?       // ID or Firebase UID of team creator
  createdAt    DateTime      @default(now())
  
  // Phase 1: Track selection & Idea submission
  problemStatement   String?
  implementationType String?
  pptUrl             String?
  understanding      String?
  solutionSummary    String?
  submittedAt        DateTime?

  phase1Unlocked     Boolean?      @default(true)
  phase2Unlocked     Boolean?      @default(false)

  // Phase 2: Final Project submission
  finalDocUrl      String?
  finalRepoUrl     String?
  finalDemoUrl     String?
  finalSummary     String?
  finalSubmittedAt DateTime?

  // Evaluation & Scoring (3 Criteria: Innovation, Understanding of Problem Statement, Progress)
  scoreInnovation     Float?
  scoreUnderstanding  Float?
  scoreProgress       Float?
  scoreTotal          Float?
  evaluatedBy         String?
  evaluationNotes     String?
  evaluatedAt         DateTime?
  
  participants Participant[] // Hard max limit of 4 enforced in logic
  evaluations  TeamEvaluation[]
}

model TeamEvaluation {
  id                 String    @id @default(uuid())
  teamId             String
  team               Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round              Int       // 1: Internal Review 1, 2: Internal Review 2, 3: External Review
  
  scoreInnovation    Float?
  scoreUnderstanding Float?
  scoreProgress      Float?
  scoreTotal         Float?
  
  evaluatedBy        String?
  evaluationNotes    String?
  evaluatedAt        DateTime  @default(now())
  
  isFrozen           Boolean   @default(true) // Automatically frozen on evaluator submission
  
  @@unique([teamId, round])
}

model Participant {
  id               String   @id @default(uuid())
  
  // Firebase Integration
  firebaseUid      String   @unique // The unique ID provided by Firebase Auth
  emailId          String   @unique // The verified email from Firebase
  
  // Registration Form Data
  fullName         String
  mobileNumber     String   @unique
  gender           String?  // e.g. "Male", "Female"
  hostelBlock      String   // e.g., "Men's Block A"
  roomNumber       String   // e.g., "412"
  messCaterer      String   // e.g., "PR Food"
  messType         String   // e.g., "Veg", "Non-Veg"
  consentAgreed    Boolean  @default(true)
  
  // Metadata
  registrationTime DateTime @default(now())
  ticketId         String   @unique @default(cuid()) // Generated Node PIN
  
  // Foreign Key to Team (Optional: they can register individually first)
  teamId           String?
  team             Team?    @relation(fields: [teamId], references: [id])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
